{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hydras",
  "version": "0.2.0",
  "identifier": "software.hydras.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @hydras/web dev",
    "beforeBuildCommand": "pnpm --filter @hydras/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hydras",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#090909"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hydras",
    "copyright": "Hydras contributors",
    "category": "DeveloperTool",
    "shortDescription": "Offline-first multiplayer code editor",
    "longDescription": "Hydras lets 4+ people edit the same files live, keep working offline, and merge cleanly on reconnect. Undo only touches your own changes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Hydras",
        "compression": "lzma"
      }
    },
    "resources": {
      "../../../dist/Hydras-LAN-v2-Windows/": "lan/"
    }
  }
}
