{
  "name": "Hydras",
  "short_name": "Hydras",
  "description": "Offline-first multiplayer code editor. Edit together, keep typing offline, merge cleanly on reconnect.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f4f1",
  "theme_color": "#090909",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
